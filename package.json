{
  "name": "workflowy-mcp",
  "version": "0.1.0",
  "description": "MCP server exposing WorkFlowy outlines as tools, backed by the karelklima/workflowy client.",
  "type": "module",
  "bin": {
    "workflowy-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
